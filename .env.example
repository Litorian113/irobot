# Local development only: the browser uses this key directly.
# Never deploy with this - a VITE_ variable is baked into the public bundle.
VITE_OPENAI_API_KEY=sk-...

# Deployment (Vercel): do NOT set VITE_OPENAI_API_KEY there. Instead set
#   OPENAI_API_KEY=sk-...
# in the Vercel project settings (no VITE_ prefix). The serverless function
# api/token.js then mints short-lived client secrets for the browser and the
# real key never leaves the server.
